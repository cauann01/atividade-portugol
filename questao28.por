programa {
  funcao inicio() {
     cadeia senha
        faca {
            escreva("Digite a senha: ")
            leia(senha)

            se (senha != "1234") {
                escreva("Senha incorreta! Tente novamente.\n")
            }

        } enquanto (senha != "1234")

        escreva("Senha correta! Acesso liberado.\n")

  }
}
